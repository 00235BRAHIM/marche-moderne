<script>
document.addEventListener('DOMContentLoaded', function () {
    const button = document.getElementById('vendorNotificationButton');
    const panel = document.getElementById('vendorNotificationPanel');
    const wrapper = document.getElementById('vendorNotificationWrapper');
    const count = document.getElementById('vendorNotificationCount');
    const list = document.getElementById('vendorNotificationList');
    const readAllButton = document.getElementById('vendorNotificationReadAll');

    if (!button || !panel || !wrapper || !count || !list) {
        return;
    }

    async function loadVendorNotifications() {
        try {
            const response = await fetch('{{ route('vendor.notifications') }}', {
                headers: {
                    'Accept': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                }
            });

            if (!response.ok) {
                throw new Error('Erreur HTTP ' + response.status);
            }

            const data = await response.json();

            if (data.count > 0) {
                count.textContent = data.count > 99 ? '99+' : data.count;
                count.classList.remove('hidden');
                count.classList.add('flex');
            } else {
                count.classList.add('hidden');
                count.classList.remove('flex');
            }

            if (!data.notifications || data.notifications.length === 0) {
                list.innerHTML = `
                    <div class="p-10 text-center">
                        <div class="w-14 h-14 mx-auto rounded-full bg-slate-100
                                    flex items-center justify-center text-2xl mb-3">
                            🔕
                        </div>

                        <p class="font-semibold text-slate-700">
                            Aucune nouvelle commande
                        </p>

                        <p class="text-xs text-slate-400 mt-1">
                            Les nouvelles commandes apparaîtront ici.
                        </p>
                    </div>
                `;
                return;
            }

            list.innerHTML = data.notifications.map(notification => {

                const total = new Intl.NumberFormat('fr-FR').format(
                    Number(notification.total || 0)
                );

                const isPayment = notification.type === 'vendor_payment_proof';

                const isSubscription =
                    notification.type === 'vendor_subscription_approved'
                    || [
                        'subscription_approved',
                        'subscription_activated',
                        'subscription_expired',
                        'subscription_cancelled'
                    ].includes(notification.event);

                const isCertification =
                    notification.type === 'vendor_certification'
                    || [
                        'certification_approved',
                        'certification_rejected',
                        'certification_suspended'
                    ].includes(notification.event);

                const title =
                    notification.title
                    || (isPayment
                        ? 'Nouvelle preuve de paiement'
                        : isSubscription
                            ? 'Abonnement'
                            : isCertification
                                ? 'Certification vendeur'
                                : 'Nouvelle commande');

                const icon =
                    notification.icon
                    || (isPayment
                        ? '💳'
                        : isSubscription
                            ? '📋'
                            : isCertification
                                ? '📄'
                                : '🛒');

                const iconClass =
                    isPayment
                        ? 'bg-emerald-100 text-emerald-700'
                        : isSubscription
                            ? 'bg-green-100 text-green-700'
                            : isCertification
                                ? 'bg-amber-100 text-amber-700'
                                : 'bg-indigo-100 text-indigo-700';

                const message =
                    notification.message
                    || (isPayment
                        ? 'Le client a envoyé une nouvelle preuve de paiement.'
                        : isSubscription
                            ? 'Une mise à jour concernant votre abonnement est disponible.'
                            : isCertification
                                ? 'Une mise à jour concernant votre certification est disponible.'
                                : 'Une nouvelle commande vous a été attribuée.');

                const orderNumber =
                    notification.vendor_order_number
                    || notification.order_number
                    || '';

                const showOrderInfo = !isSubscription && !isCertification;
                const showAmount = !isSubscription && !isCertification;
                const showProvider = isPayment && notification.provider;

                const actionText =
                    isPayment || (!isSubscription && !isCertification)
                        ? 'Voir la commande'
                        : isSubscription
                            ? 'Ouvrir mon espace vendeur'
                            : 'Voir ma certification';

                return `
                    <div
                        class="group border-b border-slate-100 last:border-b-0
                               ${notification.read ? 'bg-white' : 'bg-indigo-50/70'}
                               hover:bg-slate-50 transition"
                    >
                        <a
                            href="${notification.url}"
                            class="block p-4"
                            data-vendor-notification-link
                            data-id="${notification.id}"
                        >
                            <div class="flex gap-3">

                                <div class="w-11 h-11 rounded-2xl ${iconClass}
                                            flex items-center justify-center text-xl
                                            flex-shrink-0 shadow-sm">
                                    ${icon}
                                </div>

                                <div class="flex-1 min-w-0">

                                    <div class="flex items-start justify-between gap-2">

                                        <div>
                                            <p class="font-bold text-sm text-slate-900">
                                                ${title}
                                            </p>

                                            ${
                                                isPayment
                                                    ? `
                                                        <p class="text-sm text-slate-600 mt-1">
                                                            ${notification.customer_name || 'Client'}
                                                        </p>
                                                    `
                                                    : ''
                                            }
                                        </div>

                                        ${
                                            !notification.read
                                                ? '<span class="w-2.5 h-2.5 rounded-full bg-red-500 flex-shrink-0 mt-1.5 shadow-sm"></span>'
                                                : ''
                                        }

                                    </div>

                                    ${
                                        showOrderInfo
                                            ? `
                                                <p class="text-xs text-slate-500 mt-2">
                                                    Commande
                                                    <span class="font-semibold text-slate-700">
                                                        ${orderNumber || '-'}
                                                    </span>
                                                </p>
                                            `
                                            : ''
                                    }

                                    ${
                                        showAmount
                                            ? `
                                                <div class="flex flex-wrap items-center gap-3 mt-3">
                                                    <span class="text-sm font-bold text-indigo-600">
                                                        ${total} FCFA
                                                    </span>

                                                    ${
                                                        showProvider
                                                            ? `
                                                                <span class="text-[11px] text-slate-400">
                                                                    💳 ${
                                                                        notification.provider === 'airtel_money'
                                                                            ? 'Airtel Money'
                                                                            : 'Moov Money'
                                                                    }
                                                                </span>
                                                            `
                                                            : ''
                                                    }

                                                    <span class="text-[11px] text-slate-400">
                                                        📅 ${notification.created_at}
                                                    </span>

                                                    <span class="text-[11px] text-slate-400">
                                                        🕐 ${notification.time}
                                                    </span>
                                                </div>
                                            `
                                            : `
                                                <div class="mt-2">
                                                    <span class="text-[11px] text-slate-400">
                                                        📅 ${notification.created_at}
                                                    </span>

                                                    <span class="text-[11px] text-slate-400 ml-2">
                                                        🕐 ${notification.time}
                                                    </span>
                                                </div>
                                            `
                                    }

                                    <p class="text-xs text-slate-600 mt-2">
                                        ${message}
                                    </p>

                                    <div class="mt-3 inline-flex items-center gap-1
                                                text-xs font-bold text-indigo-600
                                                group-hover:text-indigo-800">

                                        ${actionText}

                                        <span class="transition-transform
                                                     group-hover:translate-x-1">
                                            →
                                        </span>

                                    </div>

                                </div>

                            </div>
                        </a>
                    </div>
                `;
            }).join('');

            document.querySelectorAll('[data-vendor-notification-link]')
                .forEach(link => {
                    link.addEventListener('click', async function () {
                        try {
                            await deleteVendorNotification(this.dataset.id);
                        } catch (error) {
                            console.error('Suppression notification vendeur:', error);
                        }
                    });
                });

        } catch (error) {
            console.error('Notifications vendeur:', error);

            list.innerHTML = `
                <div class="p-8 text-center">
                    <div class="text-2xl mb-2">⚠️</div>

                    <p class="text-sm text-red-500">
                        Impossible de charger les notifications.
                    </p>
                </div>
            `;
        }
    }

    async function deleteVendorNotification(id) {
        const response = await fetch(
            '{{ url('/vendor/notifications') }}/' + id + '/read',
            {
                method: 'POST',
                headers: {
                    'X-CSRF-TOKEN': '{{ csrf_token() }}',
                    'Accept': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                }
            }
        );

        if (!response.ok) {
            throw new Error('Impossible de supprimer la notification.');
        }

        await loadVendorNotifications();
    }

    if (readAllButton) {
        readAllButton.textContent = 'Tout effacer';

        readAllButton.addEventListener('click', async function () {
            try {
                const response = await fetch(
                    '{{ route('vendor.notifications.read-all') }}',
                    {
                        method: 'POST',
                        headers: {
                            'X-CSRF-TOKEN': '{{ csrf_token() }}',
                            'Accept': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    }
                );

                if (!response.ok) {
                    throw new Error('Impossible de supprimer les notifications.');
                }

                await loadVendorNotifications();

            } catch (error) {
                console.error('Suppression notifications vendeur:', error);
            }
        });
    }

    button.addEventListener('click', function (event) {
        event.stopPropagation();

        panel.classList.toggle('hidden');

        if (!panel.classList.contains('hidden')) {
            loadVendorNotifications();
        }
    });

    document.addEventListener('click', function (event) {
        if (!wrapper.contains(event.target)) {
            panel.classList.add('hidden');
        }
    });

    loadVendorNotifications();

    setInterval(loadVendorNotifications, 10000);
});
</script>
@endif


