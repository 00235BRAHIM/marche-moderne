APP_NAME="Souk Kabir"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
LOG_CHANNEL=stack
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=souk_kabir
DB_USERNAME=root
DB_PASSWORD=
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public
MAIL_MAILER=log
PAYMENT_CURRENCY=XAF

# Automatic Mobile Money payments
AIRTEL_MONEY_ENABLED=false
AIRTEL_MONEY_BASE_URL=https://openapi.airtel.africa
AIRTEL_MONEY_CLIENT_ID=
AIRTEL_MONEY_CLIENT_SECRET=
AIRTEL_MONEY_COUNTRY=TD
AIRTEL_MONEY_CURRENCY=XAF
AIRTEL_MONEY_COLLECTION_PATH=/merchant/v1/payments/
AIRTEL_MONEY_STATUS_PATH=/standard/v1/payments/{id}
AIRTEL_MONEY_CALLBACK_SECRET=

MOOV_MONEY_ENABLED=false
MOOV_MONEY_BASE_URL=
MOOV_MONEY_API_KEY=
MOOV_MONEY_MERCHANT_ID=
MOOV_MONEY_COUNTRY=TD
MOOV_MONEY_CURRENCY=XAF
MOOV_MONEY_COLLECTION_PATH=/payments
MOOV_MONEY_STATUS_PATH=/payments/{id}
MOOV_MONEY_CALLBACK_SECRET=
